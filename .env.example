# SCAMGUARD AI - Environment Configuration Example
# Copy this file to .env in production / local dev and provide real values

# Server Port
PORT=8000

# Node Environment (development | production)
NODE_ENV=development

# Frontend URL (for CORS and session cookie security)
FRONTEND_ORIGIN=http://localhost:8080

# Secret key used for signing session cookies (use a long random 32+ character string)
SESSION_SECRET=replace_with_a_secure_long_random_session_secret_scamguard_2026

# AI Classification Engine (OpenAI API and/or Google Gemini API)
# Store your secret API keys here on the server only. Never expose to client!

# OpenAI API Key & Model (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key & Model (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Database path (SQLite file path)
DATABASE_URL=./scamguard.db

# Initial Admin Credentials (used during npm run seed:admin)
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=shreyasc299@gmail.com
ADMIN_PASSWORD=Shreyas@631

# Client Production API Target (optional for frontend on Netlify)
# When deploying to Netlify, set VITE_API_URL to your deployed backend service URL:
# VITE_API_URL=https://scamguard-api.onrender.com
VITE_API_URL=