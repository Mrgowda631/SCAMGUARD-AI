# SCAMGUARD AI - Client Environment Configuration Example
# Copy to client/.env when targeting a custom backend in development or production

# Target Backend API URL (leave blank to use relative '/api' proxy)
# In production on Netlify, you can configure this in Netlify Site Settings:
# Site Settings -> Environment variables -> VITE_API_URL = https://your-backend.onrender.com
VITE_API_URL=

